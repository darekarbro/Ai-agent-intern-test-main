# Copy this file to .env and fill in ONE of the provider blocks below.
# Never commit .env.

# ---------------------------------------------------------------------------
# 1) Choose a provider. LLM_PROVIDER selects which block below is used.
#    Options: groq | gemini | ollama | openrouter | deepseek | qwen | nvidia | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# ---------------------------------------------------------------------------
# 2) Set the matching key (leave the others blank/commented).
#    LLM_MODEL and LLM_BASE_URL are optional -- sensible free-model defaults
#    are built in for every provider below; only set them to override.
# ---------------------------------------------------------------------------

# --- Groq (recommended default: fast, free tier, no card required) ---------
# Get a key: https://console.groq.com
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (free tier, no card required) ----------------------------
# Get a key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# --- Ollama (100% free, fully local, no key or signup at all) --------------
# Install: https://ollama.com, then `ollama pull llama3.1` and `ollama serve`
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# --- OpenRouter (one key, many free models incl. DeepSeek and Qwen) --------
# Get a key: https://openrouter.ai/keys -- pick a model with a ":free" suffix
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# other free options: deepseek/deepseek-chat-v3.1:free, qwen/qwen-2.5-72b-instruct:free

# --- DeepSeek direct (new accounts get free trial credit) ------------------
# Get a key: https://platform.deepseek.com
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# --- Qwen / Alibaba Model Studio (free tier quota for new accounts) --------
# Get a key: https://bailian.console.alibabacloud.com
# LLM_PROVIDER=qwen
# LLM_API_KEY=
# LLM_MODEL=qwen-plus

# --- NVIDIA NIM (free API key, generous free-credit allotment) -------------
# Get a key: https://build.nvidia.com -- hosts Qwen, DeepSeek, Llama, Mistral
# LLM_PROVIDER=nvidia
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen2.5-72b-instruct

# --- Anthropic (Claude) -- not free, but supported if you have a key -------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Other config
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
